<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!-- JDBC connection settings -->
        <property name="hibernate.connection.driver_class">org.sqlite.JDBC</property>
        <property name="hibernate.connection.url">jdbc:sqlite:losPollosHermanos.db</property>
        <property name="dialect">org.hibernate.community.dialect.SQLiteDialect</property>

        <!-- Schema update -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Debugging -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Register your entities -->
        <mapping class="Models.DBModels.transport.Driver"/>
        <mapping class="Models.DBModels.transport.Branch"/>
        <mapping class="Models.DBModels.transport.DeliveryFileItem"/>
        <mapping class="Models.DBModels.transport.DeliveryFile"/>
        <mapping class="Models.DBModels.transport.APhysicalSite"/>
        <mapping class="Models.DBModels.suppliers.Supplier"/>

    </session-factory>
</hibernate-configuration>
